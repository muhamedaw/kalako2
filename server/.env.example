# Port the Node process listens on (nginx reverse-proxies to this)
PORT=4001

# Public base URL used to build join links / QR codes, e.g. https://kalak-16-16-218-187.sslip.io
JOIN_BASE_URL=http://localhost:4001

# Absolute or relative path to the SQLite file (game history archive)
DB_PATH=./data/kalak.sqlite

# Socket.io / Express CORS — comma-separated explicit allowlist. Never '*': this API
# handles real payments and per-device coin balances. Falls back to the known
# production origin + localhost:5173 if unset (see src/config.mts).
CORS_ORIGIN=https://kalako-client.vercel.app,http://localhost:5173

# Milliseconds a disconnected player's seat is held before being removed (30s)
RECONNECT_WINDOW_MS=30000

# Seconds a voting round waits before auto-resolving (answer time is set per-room by the host)
VOTE_TIME_SECONDS=30

# Shortened timer used for TIEBREAKER rounds
TIEBREAKER_TIME_SECONDS=15

# PayPal REST API v2 (Orders) credentials — get sandbox app creds from
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_MODE=sandbox

# Gate for the get_recent_errors debug socket event — generate your own random string
# (e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`), keep secret.
DEBUG_TOKEN=

# Password for the hidden question-bank admin dashboard (?admin=true). Generate your own:
# `node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"`
ADMIN_PASSWORD=

# Gmail SMTP for passwordless email recovery codes. Without both, add_recovery_email /
# request_account_recovery send nothing and fail gracefully
# (add_recovery_email acks {success:false, error:'email_not_configured'}).
# GMAIL_APP_PASSWORD is a 16-char Google App Password (needs 2FA enabled), not your normal
# Gmail password — generate one at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
RECOVERY_EMAIL_FROM_NAME=Kalako
